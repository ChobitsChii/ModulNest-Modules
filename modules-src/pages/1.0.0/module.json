{
  "manifest_version": 2,
  "id": "modulnest.pages",
  "name": "Pages",
  "description": "Öffentliche Markdown-Seiten mit Adminverwaltung und Header-/Footer-Integration.",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "ModulNest contributors"
    }
  ],
  "homepage": "https://github.com/ChobitsChii/ModulNest",
  "repository": "https://github.com/ChobitsChii/ModulNest",
  "route_prefix": "pages",
  "access_level": "public",
  "requires": {
    "core": ">=2.0.0-alpha.1 <3.0.0",
    "php": ">=8.3.0",
    "extensions": [
      "pdo"
    ]
  },
  "entrypoint": {
    "class": "ModulNest\\Pages\\PagesModule",
    "file": "src/PagesModule.php"
  },
  "autoload": {
    "psr4": {
      "ModulNest\\Pages\\": "src/"
    }
  },
  "dependencies": {},
  "optional_dependencies": {},
  "conflicts": {},
  "migrations": {
    "path": "migrations"
  },
  "views": {
    "path": "views"
  },
  "capabilities": {
    "page_links": "ModulNest\\Pages\\PagesRepository"
  },
  "data": {
    "schema_version": 1,
    "compatible_schema": "=1",
    "ownership": {
      "tables": [
        "pages_entries"
      ],
      "settings": [],
      "storage": [],
      "uploads": [],
      "jobs": []
    }
  }
}
