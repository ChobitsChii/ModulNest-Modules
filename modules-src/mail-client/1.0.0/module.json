{
    "manifest_version": 2,
    "id": "modulnest.mail-client",
    "name": "Mail-Client",
    "description": "Thunderbird-artiger Webmail-Client mit Multi-Account-IMAP, 3-Pane-Layout, SMTP-Versand und sicherer HTML-Mail-Anzeige.",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "ModulNest Team"
        }
    ],
    "homepage": "https://github.com/ChobitsChii/ModulNest",
    "repository": "https://github.com/ChobitsChii/ModulNest",
    "requires": {
        "core": ">=2.1.0 <3.0.0",
        "php": ">=8.3.0",
        "extensions": [
            "pdo",
            "mbstring",
            "iconv",
            "openssl"
        ]
    },
    "entrypoint": {
        "class": "ModulNest\\MailClient\\MailClientModule",
        "file": "src/MailClientModule.php"
    },
    "autoload": {
        "psr4": {
            "ModulNest\\MailClient\\": "src/"
        }
    },
    "dependencies": [],
    "optional_dependencies": [],
    "conflicts": [],
    "migrations": {
        "path": "migrations"
    },
    "views": {
        "path": "views"
    },
    "assets": {
        "path": "assets"
    },
    "data": {
        "schema_version": 1,
        "compatible_schema": "=1",
        "ownership": {
            "tables": [
                "mail_client_accounts",
                "mail_client_folder_cache",
                "mail_client_message_index",
                "mail_client_sender_whitelist"
            ],
            "settings": [],
            "storage": [],
            "uploads": [],
            "jobs": []
        }
    },
    "route_prefix": "mail-client",
    "access_level": "user",
    "channel": "stable"
}
