{
  "manifest_version": 2,
  "id": "modulnest.wiki",
  "name": "Wiki",
  "description": "Synchronisierte Markdown-Dokumentation aus GitHub oder einem lokalen Verzeichnis.",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [{"name": "ModulNest contributors"}],
  "homepage": "https://github.com/ChobitsChii/ModulNest",
  "repository": "https://github.com/ChobitsChii/ModulNest",
  "route_prefix": "wiki",
  "access_level": "user",
  "requires": {"core": ">=2.0.0-alpha.1 <3.0.0", "php": ">=8.3.0", "extensions": ["pdo", "zip"]},
  "entrypoint": {"class": "ModulNest\\Wiki\\WikiModule", "file": "src/WikiModule.php"},
  "autoload": {"psr4": {"ModulNest\\Wiki\\": "src/"}},
  "dependencies": {},
  "optional_dependencies": {"modulnest.data-portability": ">=1.0.0"},
  "conflicts": {},
  "migrations": {"path": "migrations"},
  "views": {"path": "views"},
  "assets": {"path": "assets"},
  "capabilities": {"data_portability": "ModulNest\\Wiki\\WikiDataPortabilityProvider"},
  "data": {
    "schema_version": 1,
    "compatible_schema": "=1",
    "ownership": {
      "tables": ["wiki_sources", "wiki_pages", "wiki_assets", "wiki_sync_runs", "wiki_search_state", "wiki_search_documents", "wiki_search_terms", "wiki_search_postings", "wiki_search_trigrams"],
      "settings": [],
      "storage": ["content", "staging"],
      "uploads": [],
      "jobs": []
    }
  }
}
